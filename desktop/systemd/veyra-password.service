[Unit]
Description=Create the VeyraOS live user and set its password
After=live-config.service
Before=display-manager.service

[Service]
Type=oneshot
ExecStart=/bin/sh -ec 'if ! id -u veyra >/dev/null 2>&1; then adduser --disabled-password --gecos "" --uid 1000 veyra; fi; usermod -aG sudo,audio,video veyra; echo "veyra:veyra1" | chpasswd'

[Install]
WantedBy=multi-user.target
